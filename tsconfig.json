{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Migration complete — allow the 3 content-excluded .jsx files (see PROGRESS.md) to still compile */
    "allowJs": true,
    "checkJs": false,
    "strict": true,

    /* Path roots */
    "baseUrl": "."
  },
  "include": ["app/src"],
  "exclude": ["node_modules", "app/static"]
}
